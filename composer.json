{
    "name": "tunishop/marketplace",
    "description": "Marketplace locale de l'artisanat tunisien — Sidi Bou Said (BTS DI 2-1)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "dompdf/dompdf": "3.1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php tests/run.php",
        "test:ecommerce": "@php tests/ecommerce.php",
        "test:security": "@php tests/security.php",
        "test:all": [
            "@php tests/run.php",
            "@php tests/ecommerce.php",
            "@php tests/security.php"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
