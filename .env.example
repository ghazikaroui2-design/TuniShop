# Copier vers .env ( NON versionné ) puis adapter si besoin
APP_ENV=local
APP_DEBUG=true
# Laisser vide quand public/ est la racine du serveur (cas recommande).
# Ne renseigner que si l'application est servie depuis un sous-dossier.
APP_BASE_URL=
APP_TIMEZONE=Africa/Tunis

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tunishop
DB_USER=root
DB_PASSWORD=

SESSION_NAME=tunishop_session
SESSION_SECURE=false
